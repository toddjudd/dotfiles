{{- $pandiumMcpPath := promptStringOnce . "pandiumMcpPath" "Absolute path to your local pandium-mcp checkout (forward slashes, e.g. C:/git/pandium-mcp or /Users/todd/git/pandium-mcp)" -}}
{{- $mcpPath := promptStringOnce . "mcpPath" "Optional PATH to prepend to MCP server environments (needed on WSL for asdf shims, e.g. /home/todd/.asdf/shims:/home/todd/.local/bin:/usr/local/bin:/usr/bin:/bin). Leave blank on macOS/Windows" "" -}}
{{- $reduxMcpPath := promptStringOnce . "reduxMcpPath" "Absolute path to your local integrations-redux-mcp checkout (forward slashes, e.g. c:/your/path/integrations-redux/mcp)" -}}
{{- $whiplashMcpPath := promptStringOnce . "whiplashMcpPath" "Absolute path to your local whiplash-mcp checkout (forward slashes, e.g. C:/git/whiplash-mcp or /Users/todd/git/whiplash-mcp)" -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    pandiumMcpPath = {{ $pandiumMcpPath | quote }}
    mcpPath = {{ $mcpPath | quote }}
    reduxMcpPath = {{ $reduxMcpPath | quote }}
    whiplashMcpPath = {{ $whiplashMcpPath | quote }}
