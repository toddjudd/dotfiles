# Repo documentation that should live in the source only, not in $HOME.
README.md
LICENSE
LICENSE.md

# Files that exist in the destination but chezmoi should never manage/remove.
# The opencode plugin runtime writes these into ~/.config/opencode locally.
.config/opencode/node_modules
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock

# gh writes hosts.yml at runtime (contains an oauth_token). Never manage it.
.config/gh/hosts.yml

# ---- Per-OS guards ----------------------------------------------------------
{{ if ne .chezmoi.os "darwin" }}
# macOS-only assets
.config/iterm2
.config/karabiner
{{ end }}
{{ if eq .chezmoi.os "windows" }}
# Not applicable on Windows (managed on macOS and WSL/Linux only)
.zshrc
.config/.zsh
.ssh/config
{{ end }}
{{ if ne .chezmoi.os "windows" }}
# Windows-only assets
.config/powershell
{{ end }}
