# ~/.bashrc: executed by bash(1) for non-login shells.
# This file is managed by chezmoi (source: dotfiles repo). Edit it there and run
# `chezmoi apply`, not here. See the chezmoi source dir for related config.
# Bash is the login shell on Linux (e.g. Duke); on macOS zsh is primary and this
# file is unused but harmless.

# --- PATH / environment for ALL shells (interactive + non-interactive) -------
# These MUST come before the interactivity guard below so that non-interactive
# shells (scripts, `bash -c`, tools/agents like opencode) also get them.
# Only silent env/PATH setup belongs here; interactive-only setup (prompt,
# aliases, completion, tool `init` evals) stays BELOW the guard.

# rust/cargo env (also adds ~/.local/bin on some installs); source if present
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# user-local bin (starship and other user-installed tools live here)
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# asdf 0.16+ is shim-based; ensure shims are on PATH (no asdf.sh sourcing needed)
[ -d "$HOME/.asdf/shims" ] && export PATH="$HOME/.asdf/shims:$PATH"

# rbenv is shim-based; ensure shims are on PATH (shims read .ruby-version, so no
# `rbenv init` needed for basic ruby/rails/bundle resolution)
[ -d "$HOME/.rbenv/shims" ] && export PATH="$HOME/.rbenv/shims:$PATH"

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# cargo env (if installed separately from ~/.local/bin/env above)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Make non-interactive bash (agents, `bash -c`, scripts) source this file so
# they inherit the PATH set above. Bash only reads BASH_ENV for non-interactive
# shells, and the exports above run before the interactivity guard, so this is
# safe and cheap.
export BASH_ENV="$HOME/.bashrc"

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# History
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command
shopt -s checkwinsize

# make less more friendly for non-text input files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Alias definitions.
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# NOTE: PATH/env exports (asdf shims, ~/.local/bin, ~/.opencode/bin, pnpm,
# cargo) and BASH_ENV were moved to the TOP of this file, above the
# interactivity guard, so non-interactive shells (agents/tools) can find node,
# npm, etc. without reinstalling them.

# Load Starship (prompt). Falls back to the default bash prompt if starship
# isn't installed yet.
if command -v starship >/dev/null 2>&1; then
    export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
    eval "$(starship init bash)"
else
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi
