// This file is managed by chezmoi (source: dotfiles repo). Edit it there and run
// `chezmoi apply`, not here. See the chezmoi source dir for related config.
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  // Perma-allow git so subagents (builders/reviewers) and the orchestrator stop
  // prompting for git commands. Order matters: opencode applies the LAST matching
  // rule, so broad allows come first and any narrower asks/denies would come last.
  "permission": {
    "bash": {
      // All git commands are allowed without prompting, including mutating ones
      // (add/commit/checkout/fetch/pull/merge/rebase/push/reset/clean).
      "git": "allow",
      "git *": "allow",
      // ripgrep (read-only search).
      "rg": "allow",
      "rg *": "allow",
      // grep (read-only search).
      "grep": "allow",
      "grep *": "allow",
      // Node package tooling.
      "npm": "allow",
      "npm *": "allow",
      "npx": "allow",
      "npx *": "allow",
      // 1Password CLI (op run wrappers, secret reads, etc.).
      "op": "allow",
      "op *": "allow",
    },
  },
  "mcp": {
    "azure-devops": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "Ryder-Whiplash",
        "--authentication",
        "azcli",
      ],
      "enabled": true,
      "environment": {
        "ado_mcp_project": "Whiplash Platform",{{ if .mcpPath }}
        "PATH": "{{ .mcpPath }}",{{ end }}
      },
    },

    // Pandium Sandbox - for testing builds from PRs.
    // Each server resolves its API key with its own `op run` at startup, so
    // launching OpenCode normally triggers one 1Password prompt per enabled
    // pandium server (two prompts with both enabled). Simple and robust - no
    // launcher wrapper needed. The vault is referenced by ID because its name
    // ("api & integrations info") contains a `&`, invalid in an op:// ref.
    "pandium-sandbox": {
      "type": "local",
      "command": [
        "op",
        "run",
        "--account",
        "whiplash",
        "--",
        "node",
        "{{ .pandiumMcpPath }}/build/index.js",
      ],
      "enabled": true,
      "environment": {
        "PANDIUM_ENV": "sandbox",
        "PANDIUM_API_KEY": "op://kyov2mu6cfgk3i5bqnn4jjvr6a/Pandium Sandbox API/api_key",{{ if .mcpPath }}
        "PATH": "{{ .mcpPath }}",{{ end }}
      },
    },

    // Pandium Production - for production operations.
    "pandium-prod": {
      "type": "local",
      "command": [
        "op",
        "run",
        "--account",
        "whiplash",
        "--",
        "node",
        "{{ .pandiumMcpPath }}/build/index.js",
      ],
      "enabled": false,
      "environment": {
        "PANDIUM_ENV": "production",
        "PANDIUM_API_KEY": "op://kyov2mu6cfgk3i5bqnn4jjvr6a/Pandium Production API/api_key",{{ if .mcpPath }}
        "PATH": "{{ .mcpPath }}",{{ end }}
      },
    },
     // Integration Redux
    "integrations-redux-prod": {
      "type": "local",
      "command": ["node", "{{ .reduxMcpPath }}/integrations-redux-mcp/build/index.js"],
      "enabled": false,
      "environment": {
        "REDUX_ENV": "production",
        "REDUX_API_BASE_URL": "https://integrations-redux.getwhiplash.com/",
        "REDUX_API_TOKEN": "op://3xner5e26bx6h4zrf32enmsdpu/s5bqr4jzwdksi2g6fsevqgkr5y/token",{{ if .mcpPath }}
        "PATH": "{{ .mcpPath }}",{{ end }}
      },
    },
    "sanity": {
      "type": "remote",
      "url": "https://mcp.sanity.io",
      "oauth": {},
      "enabled": false,
    },
    "zendesk": {
      "type": "local",
      "command": [
        "op",
        "run",
        "--account",
        "whiplash",
        "--",
        "npx",
        "-y",
        "@fruggr/zendesk-mcp-server",
      ],
      "enabled": false,
      "environment": {
        "ZENDESK_SUBDOMAIN": "whiplash",
        "ZENDESK_EMAIL": "todd.judd@whiplash.com",
        "ZENDESK_API_TOKEN": "op://3xner5e26bx6h4zrf32enmsdpu/iqn6eho7xiapsznni2aqvoiu5y/api_key",{{ if .mcpPath }}
        "PATH": "{{ .mcpPath }}",{{ end }}
      },
    },
  },
}
